{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES6",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@hkmc/data-contracts": ["./packages/data-contracts/src/index.ts"],
      "@hkmc/program-config": ["./packages/program-config/src/index.ts"],
      "@hkmc/program-config/server": ["./packages/program-config/src/server.ts"],
      "@hkmc/authz": ["./packages/authz/src/index.ts"],
      "@hkmc/airtable": ["./packages/airtable/src/index.ts"],
      "@hkmc/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
