# Monorepo env setup:
# - Local development: copy these values into the app you are running, for example
#   apps/folk/.env.local or apps/gita-life/.env.local.
# - Vercel Preview/Production: configure these in the matching Vercel Project's
#   Environment Variables settings.
# - Do not create apps/*/.env symlinks to a root env file; app-local env files
#   keep each deployable app independent.

NEXT_PUBLIC_SITE_URL=https://your-deployment.example

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy anon key is supported as a fallback for browser/server auth clients.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt
# Server-side fallback names are also supported when NEXT_PUBLIC_* values are absent.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never expose this value to browser code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff membership sync freshness gate. Protected staff requests refresh once, then fail closed after this many minutes.
STAFF_SYNC_STALE_AFTER_MINUTES=15
# Legacy name is still accepted as a fallback.
# STAFF_PROFILE_STALE_AFTER_MINUTES=15

AIRTABLE_API_TOKEN=pat_your_token
AIRTABLE_BASE_ID=app_your_base_id
AIRTABLE_CONTACTS_TABLE_ID=tbl_your_contacts_table_id
AIRTABLE_ATTENDANCE_TABLE_ID=tbl_your_attendance_table_id
AIRTABLE_SESSIONS_TABLE_ID=tbl_your_sessions_table_id
AIRTABLE_ANALYTICS_RECORD_ID=rec_your_analytics_record_id
AIRTABLE_USERS_TABLE_ID=tbl_your_users_table_id
AIRTABLE_LOCATIONS_TABLE_ID=tbl_your_locations_table_id
AIRTABLE_INTERFACE_DASHBOARD_PAGE_ID=pag_your_dashboard_page_id

FOLK_AIRTABLE_API_TOKEN=pat_your_folk_scoped_token
FOLK_AIRTABLE_BASE_ID=app_your_folk_base_id
FOLK_AIRTABLE_INTERFACE_DASHBOARD_PAGE_ID=pag_your_folk_dashboard_page_id

GITA_LIFE_AIRTABLE_API_TOKEN=pat_your_gita_life_scoped_token
GITA_LIFE_AIRTABLE_BASE_ID=app_your_gita_life_base_id
GITA_LIFE_AIRTABLE_CONTACTS_TABLE_ID=tbl_your_gita_life_contacts_table_id
GITA_LIFE_AIRTABLE_ATTENDANCE_TABLE_ID=tbl_your_gita_life_attendance_table_id
GITA_LIFE_AIRTABLE_SESSIONS_TABLE_ID=tbl_your_gita_life_sessions_table_id
GITA_LIFE_AIRTABLE_ANALYTICS_RECORD_ID=
GITA_LIFE_AIRTABLE_USERS_TABLE_ID=tbl_your_gita_life_users_table_id
GITA_LIFE_AIRTABLE_LOCATIONS_TABLE_ID=tbl_your_gita_life_locations_table_id
GITA_LIFE_AIRTABLE_INTERFACE_DASHBOARD_PAGE_ID=pag_your_gita_life_dashboard_page_id
