# Monorepo env setup:
# - Local development: copy these values into the app you are running, for example
#   apps/folk/.env.local or apps/gita-life/.env.local.
# - Vercel Preview/Production: configure these in the matching Vercel Project's
#   Environment Variables settings.
# - Do not create apps/*/.env symlinks to a root env file; app-local env files
#   keep each deployable app independent.

NEXT_PUBLIC_SITE_URL=https://your-deployment.example

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy anon key is supported as a fallback for browser/server auth clients.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt
# Server-side fallback names are also supported when NEXT_PUBLIC_* values are absent.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never expose this value to browser code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff membership sync freshness gate. Protected staff requests refresh once, then fail closed after this many minutes.
STAFF_SYNC_STALE_AFTER_MINUTES=15
# Legacy name is still accepted as a fallback.
# STAFF_PROFILE_STALE_AFTER_MINUTES=15
